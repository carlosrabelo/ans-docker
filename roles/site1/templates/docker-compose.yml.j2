services:
  site1-app:
    build: .
    container_name: site1-app
    restart: {{ site1_restart_policy }}
    expose:
      - "80"
    environment:
      TZ: '{{ site1_timezone }}'
      SITE1_BASE_DIR: '{{ site1_data_dir }}'
    volumes:
      - {{ site1_data_dir }}/www:/usr/share/nginx/html
    networks:
      - {{ ansible_hostname }}-net
      - {{ ansible_hostname }}-net-site1
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 128M
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80"]
      interval: 30s
      timeout: 10s
      retries: 3

networks:
  {{ ansible_hostname }}-net:
    name: {{ ansible_hostname }}-net
    external: true
  {{ ansible_hostname }}-net-site1:
    name: {{ ansible_hostname }}-net-site1
