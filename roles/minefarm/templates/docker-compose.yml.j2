services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: {{ minefarm_container_name }}
    restart: {{ minefarm_restart_policy }}
    ports:
      - "{{ minefarm_port }}"
    environment:
      - APACHE_DOCUMENT_ROOT=/var/www/html
    volumes:
      - {{ minefarm_data_dir }}/html:/var/www/html
      - {{ minefarm_data_dir }}/apache-config.conf:/etc/apache2/conf-available/minefarm.conf
    networks:
      - {{ ansible_hostname }}-net
    command: ["bash", "-c", "a2enconf minefarm && apache2-foreground"]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

networks:
  {{ ansible_hostname }}-net:
    external: true
