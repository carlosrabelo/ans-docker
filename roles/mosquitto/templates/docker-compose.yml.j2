services:
  mosquitto:
    image: eclipse-mosquitto:2.0.18
    container_name: {{ mosquitto_container_name }}
    restart: {{ mosquitto_restart_policy }}
    ports:
      - "{{ mosquitto_port_mqtt }}:1883"    # MQTT port
      - "{{ mosquitto_port_websocket }}:8083"  # WebSocket port
    volumes:
      - {{ mosquitto_data_dir }}/data:/mosquitto/data
      - {{ mosquitto_data_dir }}/log:/mosquitto/log
      - {{ mosquitto_data_dir }}/mosquitto.conf:/mosquitto/config/mosquitto.conf
      - {{ mosquitto_data_dir }}/passwd:/mosquitto/config/passwd
    networks:
      - {{ ansible_hostname }}-net
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          memory: 128M
    healthcheck:
      test: ["CMD", "mosquitto_pub", "-h", "localhost", "-t", "test", "-m", "healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

networks:
  {{ ansible_hostname }}-net:
    name: {{ ansible_hostname }}-net
    external: true